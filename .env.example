# Application environment
ENV=local
LOG_LEVEL=INFO
PORT=8000

# Database configuration
# Local development uses docker-compose postgres service
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/recai

# Redis configuration
# Local development uses docker-compose redis service
REDIS_URL=redis://redis:6379/0

# Data and artifacts
DATA_DIR=data
ARTIFACT_DIR=artifacts

# Optional: simple per-IP rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MIN=60

# For production (Supabase / Upstash), override the above with:
# SUPABASE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# UPSTASH_REDIS_URL=redis://:<password>@<host>:<port>/0
# DATABASE_URL=$SUPABASE_DATABASE_URL
# REDIS_URL=$UPSTASH_REDIS_URL
# ENV=prod