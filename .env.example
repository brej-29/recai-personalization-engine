# Application environment
ENV=local
LOG_LEVEL=INFO
PORT=8000

# Database configuration
# Local development uses docker-compose postgres service
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/recai

# Redis configuration
# Local development uses docker-compose redis service
REDIS_URL=redis://redis:6379/0

# Data and artifacts
DATA_DIR=data
ARTIFACT_DIR=artifacts

# For production (Supabase / Upstash), override the above with:
# DATABASE_URL=<your_supabase_postgres_connection_url>
# REDIS_URL=<your_upstash_redis_url>