# Application environment
ENV=local
LOG_LEVEL=INFO
PORT=8000

# Database configuration
# Local development (API running on the host) talks to Postgres via localhost:5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recai

# Redis configuration
# Local development (API running on the host) talks to Redis via localhost:6379
REDIS_URL=redis://localhost:6379/0

# Data and artifacts
DATA_DIR=data
ARTIFACT_DIR=artifacts

# Optional: automatically train models on startup if artifacts are missing.
# This is primarily useful in ephemeral environments like Hugging Face Spaces.
# AUTO_TRAIN_ON_BOOT=true

# Optional: simple per-IP rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MIN=60

# For production (Supabase / Upstash), override the above with:
# SUPABASE_DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# UPSTASH_REDIS_URL=redis://:<password>@<host>:<port>/0
# DATABASE_URL=$SUPABASE_DATABASE_URL
# REDIS_URL=$UPSTASH_REDIS_URL
# ENV=prod